# ============================================================================
# Sovereign AI — Environment Variables Template
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.
# ============================================================================

# ---- Database (Supabase / Neon PostgreSQL) ----------------------------------
# Use the connection pooler URL for the app (port 6543)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/DATABASE?sslmode=require

# Use the direct connection URL for migrations (port 5432)
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ---- Clerk Authentication ---------------------------------------------------
# Get from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE
CLERK_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ---- Supabase (optional — only if using Supabase client directly) ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# ---- E2B Code Interpreter ---------------------------------------------------
# Get from https://e2b.dev → Dashboard → API Keys
E2B_API_KEY=e2b_YOUR_E2B_API_KEY_HERE

# ---- Portkey AI Gateway -----------------------------------------------------
# Get from https://portkey.ai → Dashboard
PORTKEY_API_KEY=YOUR_PORTKEY_API_KEY_HERE
PORTKEY_VIRTUAL_KEY=YOUR_PORTKEY_VIRTUAL_KEY_HERE

# ---- GitHub App -------------------------------------------------------------
# Create a GitHub App at https://github.com/settings/apps
GITHUB_APP_ID=YOUR_GITHUB_APP_ID_HERE
GITHUB_APP_PRIVATE_KEY=YOUR_GITHUB_APP_PRIVATE_KEY_PEM_CONTENTS_HERE

# ---- Vercel API -------------------------------------------------------------
# Get from https://vercel.com/account/tokens
VERCEL_API_TOKEN=YOUR_VERCEL_API_TOKEN_HERE

# ---- Wrike API --------------------------------------------------------------
# Get from https://www.wrike.com/frontend/apps/index.html#api
WRIKE_API_TOKEN=YOUR_WRIKE_API_TOKEN_HERE
WRIKE_WEBHOOK_SECRET=YOUR_WRIKE_WEBHOOK_SECRET_HERE

# ---- Upstash Redis (for BullMQ) ---------------------------------------------
# Get from https://console.upstash.com
UPSTASH_REDIS_URL=https://YOUR_REDIS_NAME.upstash.io
UPSTASH_REDIS_TOKEN=YOUR_UPSTASH_REDIS_TOKEN_HERE
